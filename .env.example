# QuantDesk local configuration
# Copy this file to .env and fill in real values before first run.

# PostgreSQL connection (docker-compose default)
QD_DATABASE_URL=postgresql+psycopg://quantdesk:quantdesk-local-test@127.0.0.1:55432/quantdesk

# Encryption key for stored credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
QD_MASTER_KEY=

# Session token for API authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
QD_SESSION_TOKEN=

# Comma-separated allowed origins for CORS
QD_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Mode: "live" (real data) or "demo" (demo data environment)
QD_MODE=live

# Path to built frontend (relative to backend working dir, or absolute)
QD_FRONTEND_DIR=frontend/dist
